# Every setting the workflow reads (with $env). Placeholders only. Put them in your n8n environment and restart n8n.
# Self-hosted n8n must allow $env access in nodes:
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# ---- Stripe
# The signing secret of this webhook endpoint (Stripe Workbench > Webhooks > your event destination > Reveal secret)
STRIPE_WEBHOOK_SECRET=whsec_your_endpoint_signing_secret
# Optional. How old a signed delivery may be, in seconds (default 300, the tolerance Stripe's own libraries use)
STRIPE_TOLERANCE_SECONDS=300
# Optional. The metadata key on the Payment Link (or Checkout Session) that names the plan (default onboarding_plan)
STRIPE_PLAN_METADATA_KEY=onboarding_plan
# Optional. Keys of the Checkout custom fields for the business name and the website (letters and digits only)
STRIPE_BUSINESS_FIELD_KEY=businessname
STRIPE_WEBSITE_FIELD_KEY=website

# ---- Plans: which snapshot each plan's sub-account is created from
PLAN_SNAPSHOTS={"launch": {"snapshotId": "your-launch-snapshot-id", "label": "Launch"}, "scale": {"snapshotId": "your-scale-snapshot-id", "label": "Scale"}}

# ---- GoHighLevel agency (the agency calls use the n8n credential "HighLevel agency (OAuth2)", not a setting)
# Your agency's company ID (docs/setup.md shows a one line way to read it)
GHL_COMPANY_ID=your-agency-company-id
# The ID of your private Marketplace app (used to check that it is installed on a new sub-account)
GHL_APP_ID=your-marketplace-app-id
# Time zone given to new sub-accounts
CLIENT_TIMEZONE=America/New_York
# The calendar in the client snapshot whose booking link goes into the "Booking Link" custom value
CLIENT_BOOKING_CALENDAR=Discovery Call
# Optional. Booking link prefix (default https://api.leadconnectorhq.com/widget/booking). Use your branded API domain if you have one
GHL_BOOKING_BASE_URL=https://api.leadconnectorhq.com/widget/booking
# Optional. Rename the custom values the workflow fills, or switch one off with "". Keys: businessName, businessPhone,
# businessEmail, businessAddress, businessCity, businessState, businessPostalCode, businessCountry, businessWebsite,
# ownerFirstName, ownerName, bookingLink
CUSTOM_VALUE_NAMES=
# Optional. How long to wait for a new sub-account's snapshot and for the agency app to be installed on it
SETUP_WAIT_SECONDS=180
SETUP_POLL_SECONDS=10

# ---- Your own agency sub-account (where clients are contacts)
GHL_HOME_LOCATION_ID=your-agency-sub-account-id
# Private Integration token of that sub-account (Settings > Private Integrations), scopes in docs/setup.md
GHL_HOME_TOKEN=pit-your-agency-sub-account-token
GHL_ONBOARDING_PIPELINE_ID=your-onboarding-pipeline-id
GHL_ONBOARDING_STAGE_ID=your-onboarding-stage-id
# The tag that starts the native onboarding workflow (default new-client)
NEW_CLIENT_TAG=new-client
# Optional. Your white label app domain, for links in Slack (default https://app.gohighlevel.com)
GHL_APP_URL=https://app.gohighlevel.com

# ---- Shared secrets: make up long random strings (at least 24 characters)
# Sent in the X-Run-Secret header to the Retry webhook
RETRY_SECRET=make-up-a-long-random-string
# Sent by the native GoHighLevel workflows in the X-Onboarding-Secret header
GHL_STATUS_SECRET=make-up-another-long-random-string

# ---- Slack incoming webhook: onboarding summaries, kickoff notes and error alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ---- n8n
# The ID of the n8n data table that keeps the onboarding ledger (columns in docs/setup.md)
LEDGER_TABLE_ID=your-data-table-id
# Optional tuning
API_MAX_ATTEMPTS=3
RETRY_BASE_SECONDS=2
GHL_RATE_LIMIT_WAIT_SECONDS=10
# How long a second delivery waits for a running onboarding before Stripe gets 503 (at most 9, because Checkout waits
# up to 10 seconds for the webhook before it redirects the customer)
LOCK_WAIT_SECONDS=5
# The stuck run check (every 15 minutes) reports an onboarding with no progress for this many minutes (at least 20)
STUCK_CHECK_MINUTES=30
